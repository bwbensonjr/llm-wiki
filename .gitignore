*~
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/

# Obsidian local config (machine-specific)
.obsidian/

# mise local overrides & secrets (e.g. JINA_API_KEY)
mise.local.toml

# Quartz publish pipeline (regenerated by scripts/build-site.sh)
# - public/    built static site output
# - .quartz/   pinned Quartz checkout, cloned at build time
# - node_modules/  Quartz dependency tree
public/
node_modules/
.quartz/

# Local versions of files that can't be downloaded directly
inbox-files/
